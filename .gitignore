# Generated by the installer per-deployment — must NOT be in the repo
config/db.php
config/installed.lock

# Runtime-uploaded content (keep the folders via .gitkeep)
uploads/logos/*
uploads/items/*
uploads/menus/*
uploads/qr/*
uploads/standee/*
!uploads/**/.gitkeep

# Backups / update workspace / cache
backups/*
!backups/.gitkeep
temp/*
!temp/.gitkeep
assets/cache/*
!assets/cache/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
*.log
